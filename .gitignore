# ==========================================
# Git Ignore Configuration — Akanksha Portfolio
# ==========================================

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js Build Output & Bundles
/.next/
/out/
/build
/dist

# Testing & Coverage
/coverage

# Environment Variables & Secrets (never commit sensitive credentials)
.env
.env*
.env.local
.env.development.local
.env.test.local
.env.production.local

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# Editor & IDE Directories
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.sublime-workspace
*.sublime-project
*.swp
*.swo
*~

# Logs & Debugging Output
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Deployment Platforms
.vercel
.netlify

# TypeScript & Build Caches
*.tsbuildinfo
next-env.d.ts

# Certificates & Keys
*.pem
*.key
*.crt
